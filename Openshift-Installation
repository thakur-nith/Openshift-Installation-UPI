>Once a master is up from disk, SSH to it from the mirror host and check for logs:
ssh core@192.168.1.21
sudo journalctl -b -f -u kubelet -u crio      # look for image pull errors / "Successfully registered node"
#### In case of VMware Workstation desired DNS was not picked. To resolve it:
sudo -i
# check what br-ex has now
nmcli -f ipv4.method,ipv4.addresses,ipv4.dns,ipv4.ignore-auto-dns con show ovs-if-br-ex
# fix the active profile (br-ex)
nmcli con mod ovs-if-br-ex ipv4.ignore-auto-dns yes ipv4.dns 192.168.1.8 ipv4.dns-search ocp4.example.com
# also fix the original profile, because configure-ovs rebuilds br-ex from it on every boot
nmcli con mod "Wired connection 1" ipv4.ignore-auto-dns yes ipv4.dns 192.168.1.8 ipv4.dns-search ocp4.example.com
# apply without a full down/up
nmcli device reapply br-ex
cat /etc/resolv.conf                       # nameserver 192.168.1.8
getent hosts api-int.ocp4.example.com      # (dig isn't installed on RHCOS)
getent hosts mirror.example.com

# the kubelet has been failing for a while, so give it a clean restart
systemctl restart kubelet

### In case of One of the node not registering (/var/lib/kubelet/pki/ doesn't exist, so the kubelet has never been issued a certificate.)
a. copy kubeconfig from healthy master (ls -l /etc/kubernetes/kubeconfig;md5sum /etc/kubernetes/kubeconfig)
scp core@master01.ocp4.example.com:/etc/kubernetes/kubeconfig /tmp/bootstrap-kubeconfig
scp /tmp/bootstrap-kubeconfig core@master03.ocp4.example.com:/tmp/
b. Then on failed Master
cp -a /etc/kubernetes/kubeconfig /root/kubeconfig.bak 2>/dev/null
install -m 600 -o root -g root /tmp/bootstrap-kubeconfig /etc/kubernetes/kubeconfig
restorecon -v /etc/kubernetes/kubeconfig
rm -f /var/lib/kubelet/kubeconfig
systemctl restart kubelet
journalctl -u kubelet -f | grep -iE 'csr|certificate|registered|anonymous|forbidden'

