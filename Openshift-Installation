12. Bootstrap VM: IP from DHCP, DNS from 192.168.1.8
1. Attach and boot the ISO  (to bootstrap vm first)
2. Keep the DHCP IP but replace the DNS server
ip -br a                         # NIC name and the DHCP IP you got
nmcli con show                   # connection name, e.g. "Wired connection 1"
sudo nmcli con mod "Wired connection 1" \
  ipv4.method auto \
  ipv4.ignore-auto-dns yes \
  ipv4.dns 192.168.1.8 \
  ipv4.dns-search ocp4.example.com
sudo nmcli con up "Wired connection 1"
sudo hostnamectl set-hostname bootstrap.ocp4.example.com
cat /etc/resolv.conf             # nameserver 192.168.1.8 only

3. Test, then install
dig +short api-int.ocp4.example.com
dig +short mirror.example.com
curl -sI http://192.168.1.11/ocp4/bootstrap.ign | head -1
Do the installation:(once completed, reboot and eject CD-ROM)
sudo coreos-installer install /dev/sda --ignition-url http://192.168.1.11/ocp4/bootstrap.ign --insecure-ignition  --copy-network
## After reboot, login from VM whose ssh-key files is added to ignition file. In this case bastion/mirror node
# ssh core@192.168.1.24
[core@bs01 ~]$ cat /etc/redhat-release
## Check the bootstrap (5–15 minutes after the reboot)
[core@bs01 ~]$ journalctl -b -f -u release-image.service -u bootkube.service
[core@bs01 ~]$ sudo crictl ps | grep -E 'etcd|kube-apiserver|machine-config-server'   # should show running containers
[core@bs01 ~]$ curl -sk https://localhost:22623/config/master | head -c 100; echo     # MCS answering (JSON)
[core@bs01 ~]$ curl -sk https://api-int.ocp4.example.com:22623/config/master | head -c 100; echo
[core@bs01 ~]$ curl -sk https://api.ocp4.example.com:6443/version

