HA proxy installation
[root@mirror ~]# dnf -y install haproxy

HA Proxy Configuration

[root@mirror ~]# cat /etc/haproxy/haproxy.cfg
global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats
    ssl-default-bind-ciphers PROFILE=SYSTEM
    ssl-default-server-ciphers PROFILE=SYSTEM

defaults
    mode                    tcp
    log                     global
    option                  tcplog
    option                  dontlognull
    option                  redispatch
    retries                 3
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout check           10s
    maxconn                 3000

# Optional stats page: http://192.168.1.8:9000/stats
listen stats
    bind 192.168.1.8:9000
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s

#---------------- Kubernetes API ----------------
frontend api
    bind 192.168.1.8:6443
    default_backend api

backend api
    balance roundrobin
    server bs01     192.168.1.24:6443 check   # remove after bootstrap complete
    server master01 192.168.1.21:6443 check
    server master02 192.168.1.22:6443 check
    server master03 192.168.1.23:6443 check

#---------------- Machine Config Server ----------------
frontend machine-config
    bind 192.168.1.8:22623
    default_backend machine-config

backend machine-config
    balance roundrobin
    server bs01     192.168.1.24:22623 check  # remove after bootstrap complete
    server master01 192.168.1.21:22623 check
    server master02 192.168.1.22:22623 check
    server master03 192.168.1.23:22623 check

#---------------- Ingress HTTP ----------------
frontend ingress-http
    bind 192.168.1.8:80
    default_backend ingress-http

backend ingress-http
    balance source
    server worker01 192.168.1.25:80 check
    server worker02 192.168.1.26:80 check

#---------------- Ingress HTTPS ----------------
frontend ingress-https
    bind 192.168.1.8:443
    default_backend ingress-https

backend ingress-https
    balance source
    server worker01 192.168.1.25:443 check
    server worker02 192.168.1.26:443 check
[root@mirror ~]#

###### Appy the Changes
If selinux blocks haproxy from binding
# 1. SELinux
setsebool -P haproxy_connect_any 1

# 2. Validate
haproxy -c -f /etc/haproxy/haproxy.cfg

# 3. Firewall
firewall-cmd --permanent --add-port={6443,22623,80,443,9000}/tcp
firewall-cmd --reload

# 4. Start
systemctl enable --now haproxy
systemctl status haproxy
ss -tlnp | grep haproxy      # should show .8 on 6443, 22623, 80, 443, 9000
